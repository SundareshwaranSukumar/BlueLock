@startuml BlueLock_Architecture
!theme plain
title BlueLock — Smart Stadium Command Grid

skinparam componentStyle rectangle
skinparam shadowing false

actor "Fan / Director" as User

package "Client Tier" {
  [TanStack Start UI\nReact 19 + Zustand] as UI
  [api.ts Client] as API
}

package "Cloud Run — Frontend (nginx)" #LightYellow {
  [Static Assets\nfrontend/dist/client] as Static
}

package "Cloud Run — Backend (FastAPI)" #LightBlue {
  [main.py] as Main
  [v1_routes] as Routes
  [Controllers] as Ctrl
  [frontend_adapter] as Adapter
  [SQLite + SQLAlchemy\nSeatStatus] as DB
  [gemini_service] as GeminiSvc
  [google_traffic_service] as TrafficSvc
}

cloud "Google GenAI" as GenAI {
  [gemini-2.5-flash] as Model
}

cloud "Google Maps Platform" as Maps {
  [Routes API\nTRAFFIC_AWARE] as Routes
}

User --> UI
UI --> API
API --> Static : production HTTPS\n(VITE_API_BASE_URL)
Static --> Routes : /api/v1/*
API --> Routes : dev proxy\n127.0.0.1:8000

Main --> Routes
Routes --> Ctrl
Routes --> Adapter
Adapter --> Ctrl
Ctrl --> DB
Ctrl --> GeminiSvc
Ctrl --> TrafficSvc
GeminiSvc --> Model
TrafficSvc --> Routes

note right of Adapter
  Maps UI gates A–D
  to backend N-A, E-A, …
end note

@enduml

@startuml BlueLock_Request_Flow
!theme plain
title Ticket Booking — Integrated Path

actor Fan
participant "StadiumSeatMap" as UI
participant "apiClient" as Client
participant "Vite Proxy" as Proxy
participant "ticket_controller" as TC
database "SQLite" as DB

Fan -> UI : confirm seat
UI -> Client : lockSeat() then bookTicket()
Client -> Proxy : POST /api/v1/seats/lock\nPOST /api/v1/tickets/book
Proxy -> TC : forward JSON
TC -> DB : UPDATE SeatStatus\nINSERT UserTicket
DB --> TC : committed row
TC --> Client : ticketId, gate, QR base64
Client --> UI : render ticket

@enduml
