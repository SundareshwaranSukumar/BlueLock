# Copy to .env.local for local development

# Route /api/v1 to FastAPI (via Vite proxy + TanStack server proxy)
VITE_USE_BACKEND=true
BACKEND_URL=http://127.0.0.1:8000

# Optional: call Cloud Run directly from the browser (skip same-origin proxy)
# VITE_API_BASE_URL=https://your-service-uc.a.run.app

# Optional live telemetry WebSocket (when backend WS is enabled)
# VITE_TELEMETRY_WS_URL=wss://127.0.0.1:8000/v1/stadium/live-stream

# Fallback mock AI (only when VITE_USE_BACKEND=false)
# LOVABLE_API_KEY=
