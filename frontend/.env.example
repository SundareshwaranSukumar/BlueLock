# Copy to .env.local for local development

VITE_USE_BACKEND=true
BACKEND_URL=http://127.0.0.1:8000

# Firebase Hosting (deploy-firebase.*): leave API/WS unset — same-origin rewrites to Cloud Run.
# Cloud Run UI only (deploy-gcp.*): direct backend URL at build time:
# VITE_API_BASE_URL=https://bluelock-backend-xxxxx.run.app
# VITE_TELEMETRY_WS_URL=wss://bluelock-backend-xxxxx.run.app/api/v1/stadium/live-stream
