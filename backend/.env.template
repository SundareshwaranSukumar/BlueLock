# BlueLock backend — copy to .env and fill in values

# Required for AI concierge (/api/v1/ai/stadium-assistant)
GEMINI_API_KEY=your_google_genai_api_key_here

# Live cricket — at least one recommended for real LSG vs PBKS scores
CRICAPI_KEY=your_cricapi_key_here
# RAPIDAPI_KEY=your_rapidapi_key_here

# Google Maps Platform — Routes API traffic around Ekana (optional; synthetic fallback)
# Enable "Routes API" on the key. GOOGLE_CLOUD_API_KEY is accepted as an alias.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional runtime overrides
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=*
DATABASE_URL=sqlite:///bluelock.db
PORT=8080
