# BlueLock — copy to .env at repo root and fill values before deploy

# Used by scripts/deploy-gcp.*, deploy-firebase.*, and deploy-firebase-full.*



# --- GCP (required for deploy) ---

GCP_PROJECT_ID=

# Firebase CLI project (defaults to GCP_PROJECT_ID if unset)
# FIREBASE_PROJECT_ID=

GCP_REGION=us-central1

BACKEND_SERVICE_NAME=bluelock-backend

FRONTEND_SERVICE_NAME=bluelock-frontend



# --- API keys (passed to Cloud Run backend via --set-env-vars) ---

GEMINI_API_KEY=

GOOGLE_MAPS_API_KEY=

CRICAPI_KEY=

RAPIDAPI_KEY=



# --- Optional backend runtime (deploy script does not set these by default) ---

# CORS_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com
# deploy-firebase-full.* sets this automatically when unset

# DATABASE_URL=sqlite:///bluelock.db



# --- Frontend build overrides (optional; deploy script sets from backend URL) ---

# VITE_API_BASE_URL=https://bluelock-backend-xxxxx.run.app

# VITE_TELEMETRY_WS_URL=wss://bluelock-backend-xxxxx.run.app/api/v1/stadium/live-stream

